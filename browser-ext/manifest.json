{
  "manifest_version": 3,
  "name": "Dhyan Browser Focus Sensor",
  "version": "1.0.0",
  "description": "Privacy-preserving telemetry sensor for Dhyan (counts and categories only, zero URLs or page text)",
  "permissions": [
    "tabs",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
