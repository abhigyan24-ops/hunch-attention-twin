{
  "name": "dhyan-vscode",
  "displayName": "Hunch VS Code Sensor & Attention Companion",
  "type": "module",
  "description": "Privacy-preserving telemetry sensor, resume assist, and quiet actuator for Hunch, your attention digital twin",
  "version": "1.0.0",
  "publisher": "dhyan",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhigyan24-ops/hunch-attention-twin",
    "directory": "vscode-ext"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "test:e2e": "npm run compile && node test/e2e/run.mjs",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test:unit": "tsx node_modules/mocha/bin/mocha.js \"test/unit/**/*.test.ts\"",
    "test:integration": "tsx node_modules/mocha/bin/mocha.js \"test/integration/**/*.test.ts\"",
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dhyan-container",
          "title": "Hunch",
          "icon": "resources/dhyan-icon.svg"
        }
      ]
    },
    "views": {
      "dhyan-container": [
        {
          "type": "webview",
          "id": "dhyan.companion",
          "name": "Hunch Companion"
        },
        {
          "id": "dhyan.today",
          "name": "Today"
        },
        {
          "id": "dhyan.resume",
          "name": "Where I Left Off"
        },
        {
          "id": "dhyan.digest",
          "name": "Held for You"
        }
      ]
    },
    "commands": [
      {
        "command": "dhyan.pause",
        "title": "Hunch: Pause Tracking"
      },
      {
        "command": "dhyan.startSession",
        "title": "Hunch: Start Focus Session"
      },
      {
        "command": "dhyan.endSession",
        "title": "Hunch: End Focus Session"
      },
      {
        "command": "dhyan.park",
        "title": "Hunch: Park Intention / Note"
      },
      {
        "command": "dhyan.resume",
        "title": "Hunch: Resume Interrupted Task"
      },
      {
        "command": "dhyan.openDigest",
        "title": "Hunch: Open Held Items Digest"
      },
      {
        "command": "dhyan.connect",
        "title": "Hunch: Connect to Desktop Engine"
      },
      {
        "command": "dhyan.diagnostics",
        "title": "Hunch: Show Diagnostics"
      },
      {
        "command": "dhyan.forgetToday",
        "title": "Hunch: Forget Today's History"
      },
      {
        "command": "dhyan.openInsights",
        "title": "Hunch: Open Insights Dashboard"
      },
      {
        "command": "dhyan.toggleTimer",
        "title": "Hunch: Toggle Focus Session"
      },
      {
        "command": "dhyan.reconnect",
        "title": "Hunch: Reconnect Sensor"
      },
      {
        "command": "dhyan.showStatus",
        "title": "Hunch: Show Sensor Status"
      }
    ],
    "keybindings": [
      {
        "command": "dhyan.park",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "dhyan.resume",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "Hunch Sensor & Twin",
      "properties": {
        "dhyan.endpointFile": {
          "type": "string",
          "default": "~/.dhyan/endpoint.json",
          "description": "Path to local endpoint credentials file"
        },
        "dhyan.ingestPort": {
          "type": "number",
          "default": 47821,
          "description": "Port of the local Hunch ingest server (127.0.0.1)"
        },
        "dhyan.token": {
          "type": "string",
          "default": "",
          "description": "Authentication token shown in the Hunch laptop app"
        },
        "dhyan.assistProbability": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Propensity for resume assist intervention experiment"
        },
        "dhyan.minAwayMinutes": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Minimum away minutes before showing resume assist"
        },
        "dhyan.autoRestore": {
          "type": "boolean",
          "default": false,
          "description": "Automatically restore editor cursor and open files on resume"
        },
        "dhyan.nudges.maxPerHour": {
          "type": "number",
          "default": 4,
          "description": "Maximum nudges permitted per hour"
        },
        "dhyan.nudges.toast": {
          "type": "boolean",
          "default": false,
          "description": "Allow toast notifications for nudges"
        },
        "dhyan.digest.toastAtBreak": {
          "type": "boolean",
          "default": false,
          "description": "Allow toast notifications for digest at natural breaks"
        },
        "dhyan.exclude.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of language IDs excluded from telemetry tracking"
        },
        "dhyan.exclude.globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of files excluded from telemetry tracking"
        },
        "dhyan.exclude.workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace paths excluded from telemetry tracking"
        },
        "dhyan.diagnostics.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log verbose numeric summaries to output channel"
        }
      }
    }
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.12",
    "@types/vscode": "^1.145.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.11",
    "mocha": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
