{
  "name": "dhyan-vscode",
  "displayName": "Dhyan VS Code Sensor & Attention Companion",
  "type": "module",
  "description": "Privacy-preserving telemetry sensor and companion pet for Dhyan (counts and categories only, zero document text)",
  "version": "1.0.0",
  "publisher": "dhyan",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dhyan-container",
          "title": "Dhyan",
          "icon": "resources/dhyan-icon.svg"
        }
      ]
    },
    "views": {
      "dhyan-container": [
        {
          "type": "webview",
          "id": "dhyan.companion",
          "name": "Dhyan Companion"
        }
      ]
    },
    "configuration": {
      "title": "Dhyan Sensor",
      "properties": {
        "dhyan.ingestPort": {
          "type": "number",
          "default": 47821,
          "description": "Port of the local Dhyan ingest server (127.0.0.1)"
        },
        "dhyan.token": {
          "type": "string",
          "default": "",
          "description": "Authentication token shown in the Dhyan laptop app"
        }
      }
    },
    "commands": [
      {
        "command": "dhyan.openInsights",
        "title": "Dhyan: Open Insights Dashboard"
      },
      {
        "command": "dhyan.toggleTimer",
        "title": "Dhyan: Toggle Focus Session"
      },
      {
        "command": "dhyan.reconnect",
        "title": "Dhyan: Reconnect Sensor"
      },
      {
        "command": "dhyan.showStatus",
        "title": "Dhyan: Show Sensor Status"
      }
    ]
  }
}
