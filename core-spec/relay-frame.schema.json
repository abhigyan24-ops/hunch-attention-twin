{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhyan.local/relay-frame.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "device": {
          "type": "string",
          "enum": [
            "phone",
            "laptop"
          ]
        },
        "version": {
          "const": "1.0.0"
        },
        "lastSeqAcked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "device",
        "version",
        "lastSeqAcked"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ping"
        },
        "t0": {
          "type": "integer",
          "minimum": 0
        },
        "t1": {
          "type": "integer",
          "minimum": 0
        },
        "t2": {
          "type": "integer",
          "minimum": 0
        },
        "t3": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "t0",
        "t1",
        "t2",
        "t3"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "pong"
        },
        "t0": {
          "type": "integer",
          "minimum": 0
        },
        "t1": {
          "type": "integer",
          "minimum": 0
        },
        "t2": {
          "type": "integer",
          "minimum": 0
        },
        "t3": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "t0",
        "t1",
        "t2",
        "t3"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "events"
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "https://dhyan.local/event.schema.json"
          }
        }
      },
      "required": [
        "type",
        "fromSeq",
        "events"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ack"
        },
        "upToSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "upToSeq"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "state"
        },
        "focusState": {
          "type": "string",
          "enum": [
            "deep_focus",
            "working",
            "drifting",
            "distracted",
            "recovering",
            "break"
          ]
        },
        "laptopState": {
          "type": "string",
          "enum": [
            "flowing",
            "stuck",
            "idle_open",
            "browsing",
            "gaming",
            "away",
            "offline"
          ]
        },
        "phoneState": {
          "type": "string",
          "enum": [
            "screen_off",
            "in_app",
            "scrolling"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "declared": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "enum": [
                    "coding",
                    "studying",
                    "writing",
                    "gaming",
                    "browsing",
                    "unknown"
                  ]
                },
                "plannedMin": {
                  "type": "number",
                  "minimum": 0
                },
                "strict": {
                  "type": "boolean"
                },
                "startedTs": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "task",
                "plannedMin",
                "strict",
                "startedTs"
              ],
              "additionalProperties": false
            }
          ]
        },
        "heldCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "focusState",
        "confidence",
        "declared",
        "heldCount"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "laptopState"
          ],
          "properties": {
            "laptopState": {
              "type": "string",
              "enum": [
                "flowing",
                "stuck",
                "idle_open",
                "browsing",
                "gaming",
                "away",
                "offline"
              ]
            }
          }
        },
        {
          "required": [
            "phoneState"
          ],
          "properties": {
            "phoneState": {
              "type": "string",
              "enum": [
                "screen_off",
                "in_app",
                "scrolling"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "pet_event"
        },
        "kind": {
          "type": "string",
          "enum": [
            "held",
            "released",
            "nudge",
            "celebrate"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "kind",
        "count"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cmd": {
          "const": "declare_session"
        },
        "args": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "enum": [
                "coding",
                "studying",
                "writing",
                "gaming",
                "browsing",
                "unknown"
              ]
            },
            "plannedMin": {
              "type": "number",
              "minimum": 0
            },
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "task",
            "plannedMin",
            "strict"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "commandId",
        "issuedAt",
        "expiresAt",
        "cmd",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cmd": {
          "const": "show_now"
        },
        "args": {
          "type": "object",
          "properties": {
            "notifKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "notifKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "commandId",
        "issuedAt",
        "expiresAt",
        "cmd",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cmd": {
          "const": "end_session"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "commandId",
        "issuedAt",
        "expiresAt",
        "cmd",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cmd": {
          "const": "kill_switch"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "commandId",
        "issuedAt",
        "expiresAt",
        "cmd",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "encrypted"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
