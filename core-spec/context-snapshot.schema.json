{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhyan.local/context-snapshot.schema.json",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "focusState": {
      "type": "string",
      "enum": [
        "deep_focus",
        "working",
        "drifting",
        "distracted",
        "recovering",
        "break"
      ]
    },
    "taskType": {
      "type": "string",
      "enum": [
        "coding",
        "studying",
        "writing",
        "gaming",
        "browsing",
        "unknown"
      ]
    },
    "taskSource": {
      "type": "string",
      "enum": [
        "declared",
        "inferred"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hourBand": {
      "type": "string",
      "enum": [
        "night",
        "morning",
        "afternoon",
        "evening",
        "late"
      ]
    },
    "minutesInState": {
      "type": "number",
      "minimum": 0
    },
    "fatigueBand": {
      "type": "string",
      "enum": [
        "low",
        "med",
        "high"
      ]
    },
    "recentInterrupts30m": {
      "type": "integer",
      "minimum": 0
    },
    "laptopState": {
      "type": "string",
      "enum": [
        "flowing",
        "stuck",
        "idle_open",
        "browsing",
        "gaming",
        "away",
        "offline"
      ]
    },
    "phoneState": {
      "type": "string",
      "enum": [
        "screen_off",
        "in_app",
        "scrolling"
      ]
    },
    "secondScreenOverlap": {
      "type": "boolean"
    },
    "declaredSession": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "enum": [
                "coding",
                "studying",
                "writing",
                "gaming",
                "browsing",
                "unknown"
              ]
            },
            "plannedMin": {
              "type": "number",
              "minimum": 0
            },
            "strict": {
              "type": "boolean"
            },
            "startedTs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "task",
            "plannedMin",
            "strict",
            "startedTs"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "ts",
    "focusState",
    "taskType",
    "taskSource",
    "confidence",
    "hourBand",
    "minutesInState",
    "fatigueBand",
    "recentInterrupts30m",
    "laptopState",
    "phoneState",
    "secondScreenOverlap",
    "declaredSession"
  ],
  "additionalProperties": false
}
