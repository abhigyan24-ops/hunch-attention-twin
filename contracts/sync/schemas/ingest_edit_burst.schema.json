{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngestEditBurst",
  "type": "object",
  "properties": {
    "kind": { "const": "edit_burst" },
    "ts": { "type": "integer", "minimum": 0 },
    "editsPerMin": { "type": "integer", "minimum": 0, "maximum": 2000 },
    "saves": { "type": "integer", "minimum": 0 },
    "errors": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "integer", "minimum": 0 },
    "windowSec": { "type": "integer", "minimum": 5, "maximum": 120 }
  },
  "required": ["kind", "ts", "editsPerMin", "saves", "errors", "warnings", "windowSec"],
  "additionalProperties": false
}
