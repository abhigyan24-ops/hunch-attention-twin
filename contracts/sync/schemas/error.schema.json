{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorBody",
  "type": "object",
  "properties": {
    "code": {
      "enum": [
        "schema_invalid",
        "unsupported_version",
        "unauthorized",
        "expired",
        "replay",
        "rate_limited",
        "too_large"
      ]
    },
    "detail": { "type": "string", "maxLength": 200 }
  },
  "required": ["code"],
  "additionalProperties": false
}
