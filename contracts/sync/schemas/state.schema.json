{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateBody",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "focusState": {
      "enum": [
        "deep_focus",
        "working",
        "drifting",
        "distracted",
        "recovering",
        "break"
      ]
    },
    "laptopState": {
      "enum": [
        "flowing",
        "stuck",
        "idle_open",
        "browsing",
        "gaming",
        "away",
        "offline"
      ]
    },
    "phoneState": {
      "type": "string",
      "enum": [
        "screen_off",
        "in_app",
        "scrolling"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "declared": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "enum": [
                "coding",
                "studying",
                "writing",
                "gaming",
                "browsing",
                "unknown"
              ]
            },
            "plannedMin": {
              "type": "number",
              "minimum": 0
            },
            "strict": {
              "type": "boolean"
            },
            "startedTs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "task",
            "plannedMin",
            "strict",
            "startedTs"
          ],
          "additionalProperties": false
        }
      ]
    },
    "heldCount": {
      "type": "integer",
      "minimum": 0
    },
    "minutesInState": {
      "type": "number",
      "minimum": 0
    },
    "adapterHealthy": {
      "type": "boolean"
    }
  },
  "required": [
    "ts",
    "focusState",
    "confidence",
    "declared",
    "heldCount"
  ],
  "additionalProperties": false
}
