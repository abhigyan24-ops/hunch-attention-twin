{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EncryptedFrame",
  "type": "object",
  "properties": {
    "v": { "const": 1 },
    "t": {
      "enum": [
        "ping",
        "pong",
        "events",
        "ack",
        "state",
        "pet_event",
        "held_list",
        "command",
        "cmd_ack",
        "error"
      ]
    },
    "d": { "enum": ["l2p", "p2l"] },
    "ctr": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "c": { "type": "string", "minLength": 24, "maxLength": 65536 }
  },
  "required": ["v", "t", "d", "ctr", "c"],
  "additionalProperties": false
}
