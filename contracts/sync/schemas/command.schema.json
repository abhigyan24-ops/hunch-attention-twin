{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandBody",
  "type": "object",
  "properties": {
    "cmdId": {
      "type": "string",
      "format": "uuid"
    },
    "cmd": {
      "enum": [
        "declare_session",
        "end_session",
        "show_now",
        "kill_switch"
      ]
    },
    "args": {
      "type": "object"
    },
    "issuedTs": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "cmdId",
    "cmd",
    "args",
    "issuedTs",
    "exp"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "cmd": {
          "const": "declare_session"
        },
        "args": {
          "type": "object",
          "properties": {
            "task": {
              "type": "string",
              "enum": [
                "coding",
                "studying",
                "writing",
                "gaming",
                "browsing",
                "unknown"
              ]
            },
            "plannedMin": {
              "type": "integer",
              "minimum": 5,
              "maximum": 480
            },
            "strict": {
              "type": "boolean"
            }
          },
          "required": [
            "task",
            "plannedMin",
            "strict"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cmd",
        "args"
      ]
    },
    {
      "properties": {
        "cmd": {
          "const": "end_session"
        },
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "cmd",
        "args"
      ]
    },
    {
      "properties": {
        "cmd": {
          "const": "show_now"
        },
        "args": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "heldId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "heldId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "all": {
                  "const": true
                }
              },
              "required": [
                "all"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "cmd",
        "args"
      ]
    },
    {
      "properties": {
        "cmd": {
          "const": "kill_switch"
        },
        "args": {
          "type": "object",
          "properties": {
            "on": {
              "type": "boolean"
            }
          },
          "required": [
            "on"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cmd",
        "args"
      ]
    }
  ]
}
