{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IngestVsCodeState",
  "type": "object",
  "properties": {
    "kind": { "const": "vscode_state" },
    "ts": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["flowing", "stuck", "idle_open"] },
    "windowFocused": { "type": "boolean" },
    "debugging": { "type": "boolean" }
  },
  "required": ["kind", "ts", "state", "windowFocused"],
  "additionalProperties": false
}
