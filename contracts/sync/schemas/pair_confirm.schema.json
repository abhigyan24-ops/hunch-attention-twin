{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairConfirmFrame",
  "type": "object",
  "properties": {
    "v": { "const": 1 },
    "t": { "const": "pair_confirm" },
    "device": { "enum": ["laptop", "phone"] },
    "mac": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
  },
  "required": ["v", "t", "device", "mac"],
  "additionalProperties": false
}
