{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CmdAckBody",
  "type": "object",
  "properties": {
    "cmdId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["applied", "rejected", "expired", "duplicate"] },
    "reason": { "type": "string", "maxLength": 100 }
  },
  "required": ["cmdId", "status"],
  "additionalProperties": false
}
