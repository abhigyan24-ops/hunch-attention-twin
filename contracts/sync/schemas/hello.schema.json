{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HelloFrame",
  "type": "object",
  "properties": {
    "v": { "const": 1 },
    "t": { "const": "hello" },
    "device": { "enum": ["laptop", "phone"] },
    "sn": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" },
    "proto": {
      "type": "array",
      "items": { "type": "integer" },
      "contains": { "const": 1 },
      "minItems": 1
    },
    "lastSeqAcked": { "type": "integer", "minimum": 0 },
    "mac": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
  },
  "required": ["v", "t", "device", "sn", "proto", "lastSeqAcked", "mac"],
  "additionalProperties": false
}
