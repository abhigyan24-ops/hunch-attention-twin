{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HeldListBody",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "heldId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "appCat": {
            "type": "string",
            "enum": [
              "coding",
              "docs",
              "communication",
              "social",
              "video",
              "short_video",
              "games",
              "shopping",
              "news",
              "music",
              "learning",
              "utility",
              "system",
              "unknown"
            ]
          },
          "heldAt": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "HELD",
              "SNOOZED",
              "SCHEDULED",
              "RELEASED",
              "EXPIRED",
              "FAILED_OPEN",
              "ACTUATION_UNKNOWN"
            ]
          }
        },
        "required": [
          "heldId",
          "appCat",
          "heldAt",
          "expiresAt",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "total",
    "items"
  ],
  "additionalProperties": false
}
