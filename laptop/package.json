{
    "name":  "dhyan-laptop",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "main":  "out/main/index.js",
    "scripts":  {
                    "dev":  "electron-vite dev",
                    "build":  "electron-vite build",
                    "dist:win": "electron-vite build && electron-builder --win --publish never",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --test test/*.test.mjs",
                    "check:aw":  "node scripts/check-aw.mjs",
                    "check:s7":  "node scripts/check-s7.mjs",
                    "setup:ollama":  "node scripts/setup-ollama.mjs"
                },
    "dependencies":  {
                         "@google/genai":  "^2.32.0",
                         "ajv":  "^8.20.0",
                         "ajv-formats":  "^3.0.1",
                         "electron-log":  "^5.4.4",
                         "electron-updater":  "^6.8.11",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "ws":  "^8.18.3",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@electron-internal/extract-zip":  "file:vendor/electron-extractor",
                            "@types/node":  "^22.18.12",
                            "@types/react":  "^19.2.2",
                            "@types/react-dom":  "^19.2.2",
                            "@types/ws":  "^8.18.1",
                            "electron":  "^45.0.0",
                            "electron-builder": "26.18.0",
                            "electron-vite":  "^4.0.1",
                            "esbuild":  "^0.25.11",
                            "typescript":  "^5.9.3",
                            "vite":  "^7.1.12"
                        },
    "overrides":  {
                      "rollup":  "npm:@rollup/wasm-node@4.52.4",
                      "electron":  {
                                       "@electron-internal/extract-zip":  "file:../../vendor/electron-extractor"
                                   }
                  }
}
